{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "images": {
    "sizes": [384, 640, 828, 1200, 1920],
    "qualities": [75],
    "formats": ["image/webp"],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "zjvnxolsmfkurrwissru.supabase.co",
        "pathname": "^/storage/v1/object/public/.*$"
      }
    ],
    "localPatterns": [
      {
        "pathname": "^/assets/.*$",
        "search": ""
      }
    ]
  },
  "redirects": [
    {
      "source": "/projects/slv-greenhorizon-2",
      "destination": "/projects/slv-green-horizon-2",
      "permanent": true
    },
    {
      "source": "/projects/slv-amaravathi-grand-1",
      "destination": "/projects/slv-amaravati-grand-1",
      "permanent": true
    },
    {
      "source": "/projects/slv-amaravathi-grand-2",
      "destination": "/projects/slv-amaravati-grand-2",
      "permanent": true
    },
    {
      "source": "/projects/slv-amaravathi-grand-3",
      "destination": "/projects/slv-amaravati-grand-3",
      "permanent": true
    },
    {
      "source": "/projects/slv-amaravathi-pride",
      "destination": "/projects/slv-amaravati-pride",
      "permanent": true
    },
    {
      "source": "/projects/slv-amaravti-grand-1",
      "destination": "/projects/slv-amaravati-grand-1",
      "permanent": true
    },
    {
      "source": "/projects/slv-amaravti-grand-2",
      "destination": "/projects/slv-amaravati-grand-2",
      "permanent": true
    },
    {
      "source": "/projects/slv-amaravti-grand-3",
      "destination": "/projects/slv-amaravati-grand-3",
      "permanent": true
    },
    {
      "source": "/projects/slv-amaravti-pride",
      "destination": "/projects/slv-amaravati-pride",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.(jpg|jpeg|png|webp|avif|svg|gif|mp4|webm|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/assets/(.*)-([A-Za-z0-9_-]{8})\\.(js|mjs|css|jpg|jpeg|png|webp|avif|svg|gif|mp4|webm|pdf|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(slv-logo\\.png|favicon\\.ico|llms\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
